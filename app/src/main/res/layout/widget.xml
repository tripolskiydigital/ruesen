<?xml version="1.0" encoding="utf-8"?>
<!-- Default texts double as the widget picker preview.
     Each text line is a clipping box with two children: a static TextView (used when the text fits)
     and a very wide "track" whose layout animation scrolls a doubled copy of the text (marquee). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/emoji"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="🍎"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- RU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/ru"
                    style="@style/WidgetLine.Bold"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:text="яблоко" />

                <LinearLayout
                    android:id="@+id/ru_track"
                    style="@style/WidgetTrack">

                    <TextView
                        android:id="@+id/ru_scroll"
                        style="@style/WidgetLine.Bold"
                        android:layout_width="wrap_content" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- EN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/en_flag"
                style="@style/WidgetFlag"
                android:text="🇺🇸" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/en"
                    style="@style/WidgetLine"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:text="apple" />

                <LinearLayout
                    android:id="@+id/en_track"
                    style="@style/WidgetTrack">

                    <TextView
                        android:id="@+id/en_scroll"
                        style="@style/WidgetLine"
                        android:layout_width="wrap_content" />
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/speak_en"
                style="@style/WidgetSpeak"
                android:contentDescription="@string/speak_en" />
        </LinearLayout>

        <!-- ES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/es_flag"
                style="@style/WidgetFlag"
                android:text="🇪🇸" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/es"
                    style="@style/WidgetLine"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:text="la manzana" />

                <LinearLayout
                    android:id="@+id/es_track"
                    style="@style/WidgetTrack">

                    <TextView
                        android:id="@+id/es_scroll"
                        style="@style/WidgetLine"
                        android:layout_width="wrap_content" />
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/speak_es"
                style="@style/WidgetSpeak"
                android:contentDescription="@string/speak_es" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/circle_button"
        android:contentDescription="@string/next"
        android:padding="8dp"
        android:src="@drawable/ic_refresh" />
</LinearLayout>
